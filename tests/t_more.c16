uint g_fact = 0;
uint g_break = 0;
uint g_cont = 0;
uint g_cmp = 0;
uint g_multi = 0;
uint g_dowhile = 0;

uint factorial(uint n) {
    if (n == 0) {
        return 1;
    }
    return n * factorial(n - 1);
}

uint sum4(uint a, uint b, uint c, uint d) {
    return a * 1000 + b * 100 + c * 10 + d;
}

uint main() {
    uint i;
    uint j;

    g_fact = factorial(5);

    g_break = 0;
    for (i = 0; i < 10; i = i + 1) {
        if (i == 4) {
            break;
        }
        g_break = g_break + 1;
    }

    g_cont = 0;
    for (i = 0; i < 5; i = i + 1) {
        if (i == 2) {
            continue;
        }
        g_cont = g_cont + i;
    }

    g_cmp = compare_to_string("abc", "abc");

    g_multi = sum4(1, 2, 3, 4);

    j = 0;
    i = 0;
    do {
        j = j + i;
        i = i + 1;
    } while (i < 4);
    g_dowhile = j;

    return 0;
}
