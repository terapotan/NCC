// example1.c16
// NC16Cの主要機能（if/for/while/switch/構造体/配列/ポインタ/システムコール）の実演

struct Point {
    uint x;
    uint y;
};

uint g_total = 0;
char g_msgbuf[16];

uint add(uint a, uint b) {
    return a + b;
}

uint sum_array(uint* arr, uint len) {
    uint i;
    uint s;
    s = 0;
    for (i = 0; i < len; i = i + 1) {
        s = s + arr[i];
    }
    return s;
}

uint classify(uint n) {
    uint result;
    switch (n) {
        case 0:
            result = 100;
            break;
        case 1:
            result = 200;
            break;
        default:
            result = 999;
            break;
    }
    return result;
}

uint main() {
    uint nums[5];
    uint i;
    struct Point p;
    struct Point* pp;
    uint total;
    uint rem;
    uint status;

    for (i = 0; i < 5; i = i + 1) {
        nums[i] = i * i;
    }

    total = sum_array(nums, 5);

    p.x = 3;
    p.y = 4;
    pp = &p;
    pp->x = pp->x + 1;

    if (total > 10 && p.x == 4) {
        g_total = add(total, p.x);
    } else {
        g_total = 0;
    }

    i = 0;
    while (i < 3) {
        g_total = g_total + classify(i);
        i = i + 1;
    }

    g_total = g_total / 7;
    rem = g_total % 3;

    int_to_ascii(g_total, g_msgbuf);
    output_string(g_msgbuf);

    return g_total;
}
