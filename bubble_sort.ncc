
// 与えられた8個の数字をバブルソートで昇順に並び替える。

// 昇順で並び替える

void sort(uint* array,uint len){
    uint i = 0;
    uint j = 0;
    uint tmp = 0;

    for (i = 0;i < len - 1;i++){
        for (j = 0;j < len - 1;j++){
            if(array[j + 1] < array[j]){
                tmp = array[j];
                array[j] = array[j+1];
                array[j+1]=tmp;
            }
        }
    }
}


// 配列の中身を表示する
// array:表示対象の配列
// len:配列の長さ。配列の要素数。
void printArray(uint* array,uint len){
    char str[16];

    for(uint i = 0;i < len;i++){
        int_to_ascii(array[i],str);
        output_string(str);
        output_string(" ");
    }
    output_string("\n");
}

uint main(){
    uint array[8];
    char str[16];
    uint tmp = 0;

    output_string("Bubble sort\n");
    output_string("Sort the given numbers in ascending order.\n");

    for (uint i = 0; i < 8; i++){
        output_string("Input a number.");
        input_user_string(str);
        ascii_to_int(str,&tmp);
        array[i] = tmp;
    }
    output_string("Before sorting\n");
    printArray(array,8);

    sort(array,8);

    output_string("After sorting \n");
    printArray(array,8);

    return 0;
}